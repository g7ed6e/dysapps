// Publication de l'application sur Cloudflare Workers (https://dysapps.guillaume-delahaye.workers.dev/).
// Cloudflare lance « npm run build » puis « npx wrangler deploy » : avec ce fichier, wrangler publie dist/ tel quel,
// sans se configurer lui-même ni reconstruire l'application une seconde fois.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dysapps",
  // Le Worker ne reçoit que /api/… (la mesure d'usage anonyme, src/worker/index.ts) ; le reste est servi tel quel.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  // Adresse *.workers.dev et adresses d'aperçu, comme avant ce fichier.
  "workers_dev": true,
  "preview_urls": true,
  // Aperçus de branche (Workers Builds lance « npx wrangler preview » hors de main) : le bloc peut rester vide,
  // les fichiers servis et la compatibilité restent en haut. La branche « preview » sert de pré-version.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // La mesure d'usage : Workers Analytics Engine, créé à la première écriture, lu par scripts/pilotage/usage.mjs.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "dysapps_usage" }]
}
