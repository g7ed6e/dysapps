{
  "name": "dysapps",
  "private": true,
  "type": "module",
  "description": "Applications d'entraînement adaptées aux élèves dys du collège",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version:show": "node scripts/version.mjs",
    "splash": "node scripts/splash.mjs",
    "www:build": "vitepress build www",
    "www:dev": "vitepress dev www --port 4173",
    "www:preview": "vitepress preview www --port 4173",
    "pilotage:personnages": "node scripts/pilotage/personnages.mjs",
    "www:captures": "node scripts/www/captures.mjs",
    "programme:extract": "node scripts/programme/extract.mjs",
    "rendu:mesures": "node scripts/rendu/mesures.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "~1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1"
  }
}
