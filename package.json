{
  "name": "dysapps",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Applications d'entraînement adaptées aux élèves dys du collège",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:check": "node scripts/check-version.mjs",
    "docs:build": "node scripts/docs/build.mjs",
    "docs:dev": "node scripts/docs/build.mjs --serve",
    "docs:check": "node scripts/docs/check.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
